# Neo4j — docker-compose hardcodes NEO4J_AUTH=neo4j/companybrain
# (it does NOT read NEO4J_PASSWORD); NEO4J_PASSWORD below must match that hardcoded value.
# NEO4J_USER is not read by any script (they hardcode user 'neo4j').
NEO4J_URI=bolt://localhost:7688
NEO4J_PASSWORD=companybrain

#Langfuse Evaluation Instrumentation
LANGFUSE_PUBLIC_KEY=demo-placeholder
LANGFUSE_SECRET_KEY=demo-placeholder
LANGFUSE_HOST=http://localhost:3000

# Optional: embed model override, read by 01-context/src/embed.py and 03-evals/src/eval_ocr.py
# BG_EMBED_MODEL=google/embeddinggemma-300m
